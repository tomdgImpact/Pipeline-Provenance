# Every secret this project can read is listed here. None of them is valued.
# Copy to .env for local runs. .env is ignored and must never be committed.

# --- Audit CLI -------------------------------------------------------------
# Read-only token used by `ppv audit --remote` to fetch workflow files and
# resolve action references. Scope: public_repo (or repo:read for private
# targets). No write scope is ever required.
PPV_GITHUB_TOKEN=

# GitHub API base. Override for GitHub Enterprise Server.
PPV_GITHUB_API_URL=https://api.github.com

# --- Attestation and verification -----------------------------------------
# Keyless signing uses the ambient OIDC token in CI; there is no private key
# to configure. These only pin the transparency log and issuer for offline
# or air-gapped verification.
PPV_REKOR_URL=https://rekor.sigstore.dev
PPV_FULCIO_URL=https://fulcio.sigstore.dev
PPV_EXPECTED_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Identity the verifier requires on an attestation. Set per deployment.
PPV_EXPECTED_SIGNER_IDENTITY=

# --- Demonstration environment --------------------------------------------
# The exfiltration demo runs against a throwaway repository and a throwaway
# collector. Never point these at anything real.
PPV_DEMO_REPO=
PPV_DEMO_COLLECTOR_URL=

# --- Local behaviour -------------------------------------------------------
# Benchmarks and the audit corpus are offline by default. Set to 1 only when
# deliberately running against live repositories.
PPV_ALLOW_NETWORK=0
PPV_LOG_LEVEL=info
